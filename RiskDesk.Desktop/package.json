{
  "name": "riskdesk.desktop",
  "productName": "Florida Hurricane Landfall Event Tracker",
  "version": "1.0.0",
  "description": "A desktop report of inferred Florida hurricane landfalls from NOAA HURDAT2 data.",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-portable.ps1",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": {
    "name": "Jason Muse",
    "email": "146852983+jasonmuse@users.noreply.github.com"
  },
  "license": "MIT",
  "build": {
    "appId": "com.jasonmuse.floridalandfalldetector",
    "productName": "Florida Hurricane Landfall Event Tracker",
    "artifactName": "FloridaLandfallDetector-${version}-portable.${ext}",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "portable"
    },
    "nsis": {
      "installerIcon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
